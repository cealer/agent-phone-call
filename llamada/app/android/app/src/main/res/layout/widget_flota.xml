<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_fondo" android:orientation="vertical" android:paddingStart="12dp"
    android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textColor="#22D3EE" android:textSize="8sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.2"
            android:text="FLOTA" android:textColor="#22D3EE" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/hora" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"
            android:text="--:--" android:textColor="#6F8396" android:textSize="10sp" />
        <LinearLayout android:id="@+id/c_marcha" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:background="@drawable/chip_fondo" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/c_marcha_n" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:text="0" android:textColor="#E8EEF3" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="MARCHA"
                android:textColor="#7FA0B5" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c_decision" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:background="@drawable/chip_fondo" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/c_decision_n" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:text="0" android:textColor="#E8EEF3" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="DECISIÓN"
                android:textColor="#7FA0B5" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c_cola" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:background="@drawable/chip_fondo" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/c_cola_n" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:text="0" android:textColor="#E8EEF3" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="COLA"
                android:textColor="#7FA0B5" android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/q1_nombre" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"
            android:textColor="#E8EEF3" android:textSize="12sp" />
        <TextView android:id="@+id/q1_reinicia" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" android:fontFamily="sans-serif-condensed" android:maxLines="1"
            android:textColor="#6F8396" android:textSize="9sp" />
        <TextView android:id="@+id/q1_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:textColor="#E8EEF3"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <ProgressBar android:id="@+id/q1_barra" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp"
        android:max="100" android:progressDrawable="@drawable/barra_cuota" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/q2_nombre" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"
            android:textColor="#E8EEF3" android:textSize="12sp" />
        <TextView android:id="@+id/q2_reinicia" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" android:fontFamily="sans-serif-condensed" android:maxLines="1"
            android:textColor="#6F8396" android:textSize="9sp" />
        <TextView android:id="@+id/q2_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:textColor="#E8EEF3"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <ProgressBar android:id="@+id/q2_barra" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp"
        android:max="100" android:progressDrawable="@drawable/barra_cuota" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/q3_nombre" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"
            android:textColor="#E8EEF3" android:textSize="12sp" />
        <TextView android:id="@+id/q3_reinicia" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" android:fontFamily="sans-serif-condensed" android:maxLines="1"
            android:textColor="#6F8396" android:textSize="9sp" />
        <TextView android:id="@+id/q3_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:textColor="#E8EEF3"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <ProgressBar android:id="@+id/q3_barra" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp"
        android:max="100" android:progressDrawable="@drawable/barra_cuota" />
    <TextView android:id="@+id/tareas_nota" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:includeFontPadding="false" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end"
        android:textColor="#6F8396" android:textSize="10sp" android:visibility="gone" />
    <TextView android:id="@+id/tareas_l1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:includeFontPadding="false"
        android:textColor="#E8EEF3" android:textSize="11sp" android:visibility="gone" />
    <TextView android:id="@+id/tareas_l2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:includeFontPadding="false"
        android:textColor="#E8EEF3" android:textSize="11sp" android:visibility="gone" />
    <TextView android:id="@+id/tareas_l3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:includeFontPadding="false"
        android:textColor="#E8EEF3" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
