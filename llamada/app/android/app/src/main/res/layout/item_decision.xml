<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingTop="8dp" android:orientation="vertical">
    <LinearLayout android:id="@+id/it_cab" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="◆" android:textColor="#F2B84B" android:textSize="9sp" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/it_t" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="2"
            android:textColor="#E8EEF3" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/it_e" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="17dp" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
        android:textSize="11sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/it_fila" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="17dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/it_o1" style="@style/DecisionBoton" android:layout_width="0dp" android:layout_weight="1" />
        <Button android:id="@+id/it_o2" style="@style/DecisionBoton" android:layout_width="0dp" android:layout_weight="1" />
        <Button android:id="@+id/it_o3" style="@style/DecisionBoton" android:layout_width="0dp" android:layout_weight="1" />
        <Button android:id="@+id/it_ll" style="@style/DecisionBoton" android:layout_width="0dp" android:layout_weight="1.2"
            android:background="@drawable/boton_llamame" android:text="Llámame" android:textColor="#22D3EE" />
    </LinearLayout>
</LinearLayout>
