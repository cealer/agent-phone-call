<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd service for the call server. Copy to ~/Library/LaunchAgents/llamada.server.plist,
     replace /PATH/TO/REPO and YOUR_HOME, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/llamada.server.plist
     Restart after a change:  launchctl kickstart -k gui/$(id -u)/llamada.server -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>llamada.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/REPO/llamada/server/.venv/bin/python</string>
    <string>/PATH/TO/REPO/llamada/server/server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:YOUR_HOME/.local/bin</string>
    <!-- How the agent prompts name you: "[llamada] Ana te llamó por teléfono…" -->
    <key>LLAMADA_NOMBRE</key>
    <string>YOUR_NAME</string>
    <!-- Optional: another voice engine (see README, "Use your own model")
    <key>LLAMADA_ENGINE</key>
    <string>/PATH/TO/REPO/llamada/server/engine_openai.py</string>
    <key>LLAMADA_ENGINE_PYTHON</key>
    <string>/PATH/TO/REPO/llamada/server/.venv/bin/python</string>
    -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>YOUR_HOME/.config/llamada/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>YOUR_HOME/.config/llamada/logs/server.log</string>
</dict>
</plist>
