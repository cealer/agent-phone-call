<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd service for the call server. Copy to ~/Library/LaunchAgents/phonecall.server.plist,
     replace /PATH/TO/REPO and YOUR_HOME, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/phonecall.server.plist
     Restart after a change:  launchctl kickstart -k gui/$(id -u)/phonecall.server -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>phonecall.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/REPO/server/.venv/bin/python</string>
    <string>/PATH/TO/REPO/server/server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:YOUR_HOME/.local/bin</string>
    <!-- How the agent prompts name you: "[phonecall] Alex called you on the phone…" -->
    <key>PHONECALL_NAME</key>
    <string>YOUR_NAME</string>
    <!-- The conversation language comes from ~/.config/phonecall/language (written by install.sh).
         To override it here:
    <key>PHONECALL_LANGUAGE</key>
    <string>es</string>
    -->
    <!-- Optional: another voice engine (see README, "Use your own model")
    <key>PHONECALL_ENGINE</key>
    <string>/PATH/TO/REPO/server/engine_openai.py</string>
    <key>PHONECALL_ENGINE_PYTHON</key>
    <string>/PATH/TO/REPO/server/.venv/bin/python</string>
    -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>YOUR_HOME/.config/phonecall/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>YOUR_HOME/.config/phonecall/logs/server.log</string>
</dict>
</plist>
