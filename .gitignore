# Environments, models and build output: heavy and reproducible
.venv/
**/.venv/
models/
.runtime/
.claude/
dist/
*.tgz
*.zip
__pycache__/
*.pyc
.DS_Store
*.log

# Flutter app / Android
app/build/
app/.dart_tool/
app/.gradle/
app/android/.gradle/
app/android/local.properties
app/.flutter-plugins-dependencies
app/.idea/
app/*.iml

# Credentials and personal data: never in the repository
**/google-services.json
**/service-account*.json
**/device.json
**/config.json
**/*token*
!**/*token*.dart
voices/*/*.wav
# Recorded audio (voice clips, the short phrases make_fillers.py records at install time): never committed
*.wav
*.pcm
voices/*/voice.json

# The voice-activity model does ship (2 MB, the server needs it)
!server/models/
