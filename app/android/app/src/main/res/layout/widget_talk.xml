<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_talk" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:gravity="center_vertical" android:orientation="horizontal"
    android:padding="10dp">
        <LinearLayout android:id="@+id/b_call" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_call">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                    android:src="@drawable/ic_phone" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed" android:letterSpacing="0.1" android:maxLines="1"
                android:text="CALL" android:textColor="#E8EEF3" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b_firstmate" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_firstmate">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                    android:src="@drawable/ic_mic" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed" android:letterSpacing="0.1" android:maxLines="1"
                android:text="FIRSTMATE" android:textColor="#E8EEF3" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b_hermes" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_hermes">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                    android:src="@drawable/ic_mic" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed" android:letterSpacing="0.1" android:maxLines="1"
                android:text="HERMES" android:textColor="#E8EEF3" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b_note" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_note">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                    android:src="@drawable/ic_note" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed" android:letterSpacing="0.1" android:maxLines="1"
                android:text="NOTE" android:textColor="#E8EEF3" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
</LinearLayout>
