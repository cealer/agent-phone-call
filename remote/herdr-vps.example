#!/bin/bash
# Mac side. Runs `herdr` on the remote agent machine (VPS) over ssh, for the call server
# (config.json contact "herdr_bin" / LLAMADA_FM_SEND). Install as ~/.local/bin/herdr-vps (chmod +x) and
# replace the placeholders. The key is restricted on the VPS to llamada-ssh-gate (see remote/README.md),
# so it can run only herdr / fm-send. Arguments travel base64-encoded: accents and quotes stay intact.
VPS_USER=YOUR_VPS_USER
VPS_HOST=YOUR_VPS_TAILSCALE_NAME_OR_IP
VPS_PORT=22
KEY="$HOME/.ssh/id_ed25519_llamada"

enc=""
for a in "$@"; do enc="$enc$(printf %s "$a" | base64 | tr -d "\n"),"; done
enc="${enc%,}"
exec ssh -o BatchMode=yes -o ControlMaster=auto -o ControlPath="$HOME/.ssh/cm-llamada-%C" -o ControlPersist=600 \
  -o ConnectTimeout=8 -o ServerAliveInterval=15 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
  -i "$KEY" -p "$VPS_PORT" "$VPS_USER@$VPS_HOST" "herdr64 $enc"
