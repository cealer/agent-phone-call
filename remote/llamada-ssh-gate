#!/bin/bash
# VPS side. The forced command of the call server's ssh key (authorized_keys), so that key can only run
# `herdr` or `fm-send`, never a shell. Expects SSH_ORIGINAL_COMMAND = "<herdr64|fm-send64> <b64>,<b64>,...".
# Install as ~/.local/bin/llamada-ssh-gate (chmod +x) and in ~/.ssh/authorized_keys:
#   command="$HOME/.local/bin/llamada-ssh-gate",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding ssh-ed25519 AAAA... llamada
# (write the absolute path instead of $HOME). HERDR_BIN / FM_SEND_BIN override where the tools are.
set -euo pipefail
read -r verb encoded <<<"${SSH_ORIGINAL_COMMAND:-}"
case "$verb" in
  herdr64) tool="${HERDR_BIN:-$(command -v herdr || echo "$HOME/.local/bin/herdr")}" ;;
  fm-send64) tool="${FM_SEND_BIN:-$(command -v fm-send || echo "$HOME/.local/bin/fm-send")}" ;;
  *) echo "llamada-ssh-gate: command not allowed" >&2; exit 126 ;;
esac
args=()
if [ -n "${encoded:-}" ]; then
  IFS=',' read -r -a parts <<<"$encoded"
  for part in "${parts[@]}"; do
    args+=("$(printf %s "$part" | base64 -d)")
  done
fi
exec "$tool" ${args[@]+"${args[@]}"}
